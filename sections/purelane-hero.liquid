  <script>
    (function() {
      function initHeroSlider() {
        const stage = document.querySelector('#hstage');
        if (!stage) return;
        const slides = stage.querySelectorAll('.hslide');
        const dots = document.querySelectorAll('#hdots button');
        if (!slides.length) return;

        let currentIdx = 0;
        let timer = null;

        function goToSlide(idx) {
          currentIdx = (idx + slides.length) % slides.length;
          slides.forEach((s, i) => s.classList.toggle('on', i === currentIdx));
          dots.forEach((d, i) => d.classList.toggle('on', i === currentIdx));
        }

        function startAutoPlay() {
          if (!timer) {
            timer = setInterval(() => {
              goToSlide(currentIdx + 1);
            }, 4500); // Relaxed rotation every 4.5 seconds
          }
        }

        function stopAutoPlay() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            stopAutoPlay();
            goToSlide(index);
            startAutoPlay();
          });
        });

        stage.addEventListener('mouseenter', stopAutoPlay);
        stage.addEventListener('mouseleave', startAutoPlay);

        startAutoPlay();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroSlider);
      } else {
        initHeroSlider();
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_stage",
      "label": "Show Product Showcase Stage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Decorative Rule",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "PLANT-POWERED HOMECARE"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading Line 1",
      "default": "CLEAN"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Heading Line 2 (Highlighted)",
      "default": "THAT LASTS"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lead Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button Text",
      "default": "SHOP NOW →"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
