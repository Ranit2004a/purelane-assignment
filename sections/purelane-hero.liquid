{% comment %}
  Purelane Hero Section
  Merchant-editable hero section with auto-rotating product highlight slides every few seconds.
{% endcomment %}

<section class="hero purelane-body-root" data-scene="1" id="purelane-hero-{{ section.id }}">
  <div class="hero-grid wrap">
    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>
        <span>PLANT<br>POWERED</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>
        <span>SAFE FOR<br>KIDS &amp; PETS</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>
        <span>ZERO HARSH<br>CHEMICALS</span>
      </div>
    </div>

    <div class="hero-copy rv rv-d1">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      <h1 class="d1 purelane-d1">
        {{ section.settings.title_line1 | escape }}
        {%- if section.settings.title_line2 != blank -%}
          <br><span class="lime purelane-lime">{{ section.settings.title_line2 | escape }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.show_rule -%}
        <div class="rule" style="margin-top:14px; margin-bottom:18px;">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>
      {%- endif -%}

      {%- if section.settings.lede != blank -%}
        <p class="lede purelane-lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}

      <!-- Feature 4: Live Free Shipping Progress Bar -->
      <div class="purelane-shipping-meter glass-2">
        <div class="purelane-shipping-text">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" rx="2"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          <span>Add <strong>₹101</strong> more to unlock <strong>FREE Express Shipping!</strong></span>
        </div>
        <div class="purelane-shipping-bar-bg">
          <div class="purelane-shipping-bar-fill" style="width: 78%;"></div>
        </div>
      </div>

      <div class="hero-cta">
        {%- if section.settings.btn1_text != blank -%}
          <a href="{{ section.settings.btn1_link | default: '#shop' }}" class="btn btn-primary purelane-btn purelane-btn-primary">
            {{ section.settings.btn1_text | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn2_text != blank -%}
          <a href="{{ section.settings.btn2_link | default: '#how' }}" class="btn btn-ghost purelane-btn purelane-btn-ghost">
            {{ section.settings.btn2_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_product_stage -%}
      <div class="hero-prod" id="heroProd">
        <!-- Feature 3: Interactive Bottle Ingredient Hotspot Tooltips -->
        <div class="purelane-hotspot-container">
          <div class="purelane-hotspot" style="top: 32%; right: 25%;">
            <div class="purelane-hotspot-dot"></div>
            <div class="purelane-hotspot-tooltip glass-2">
              <strong>Coconut Surfactants</strong>
              <span>Instantly dissolves grease &amp; tough scum</span>
            </div>
          </div>
          <div class="purelane-hotspot" style="top: 55%; right: 45%;">
            <div class="purelane-hotspot-dot"></div>
            <div class="purelane-hotspot-tooltip glass-2">
              <strong>Organic Lemon Oil</strong>
              <span>Natural fresh citrus aroma without synthetics</span>
            </div>
          </div>
          <div class="purelane-hotspot" style="top: 72%; right: 15%;">
            <div class="purelane-hotspot-dot"></div>
            <div class="purelane-hotspot-tooltip glass-2">
              <strong>100% Non-Toxic</strong>
              <span>Safe for homes with pets &amp; kids</span>
            </div>
          </div>
        </div>

