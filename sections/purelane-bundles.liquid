{% comment %}
  Purelane Bundles & Categories Section
  Displays Bundle Category cards and Trust Bar matching Purelane UI design.
{% endcomment %}

<section class="sec purelane-body-root" id="bundles" data-scene="4">
  <div class="wrap purelane-wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      <h2 class="d2 purelane-d2" style="margin-top:12px;">
        {{ section.settings.title_line1 | escape }}
        {%- if section.settings.title_line2 != blank -%}
          <span class="lime purelane-lime">{{ section.settings.title_line2 | escape }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.show_rule -%}
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
          </svg>
          <i></i>
        </div>
      {%- endif -%}
    </div>

    <!-- Category Cards Grid -->
    <div class="cats">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <a class="glass cat rv" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
              <span class="ph">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 350 }}" alt="{{ block.settings.title | escape }}" class="pimg" loading="lazy">
                {%- else -%}
                  <span class="pimg {{ block.settings.icon_class | default: 'p-kitchen' }}" role="img" aria-label="{{ block.settings.title | escape }}"></span>
                {%- endif -%}
              </span>
              <span class="txt">
                <h4>{{ block.settings.title | escape }}</h4>
                <p>{{ block.settings.subtitle | escape }}</p>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback Cards matching reference design -->
        <a class="glass cat rv" href="#combos">
          <span class="ph">
            <span class="pimg p-kitchen" role="img" aria-label="Kitchen Bundle"></span>
          </span>
          <span class="txt">
            <h4>KITCHEN BUNDLE</h4>
            <p>Grease, dishes &amp; more</p>
          </span>
        </a>

        <a class="glass cat rv rv-d1" href="#combos">
          <span class="ph">
            <span class="pimg p-toilet" role="img" aria-label="Bathroom Bundle"></span>
          </span>
          <span class="txt">
            <h4>BATHROOM BUNDLE</h4>
            <p>Deep clean &amp; disinfect</p>
          </span>
        </a>

        <a class="glass cat rv rv-d2" href="#combos">
          <span class="ph">
            <span class="pimg p-laundry" role="img" aria-label="Laundry Bundle"></span>
          </span>
          <span class="txt">
            <h4>LAUNDRY BUNDLE</h4>
            <p>Softer, fresher wash</p>
          </span>
        </a>

        <a class="glass cat rv rv-d3" href="#combos">
          <span class="ph">
            <span class="pimg p-tap" role="img" aria-label="Hard Water Bundle"></span>
          </span>
          <span class="txt">
            <h4>HARD WATER BUNDLE</h4>
            <p>Melt away limescale</p>
          </span>
        </a>
      {%- endif -%}
    </div>

    <!-- Feature Trust Bar Pill -->
    {%- if section.settings.show_trust_bar -%}
      <div class="trust-bar-wrapper">
        <div class="glass trust rv">
          <div class="trust-i">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </svg>
            <span>PLANT DERIVED<br>FORMULAS</span>
          </div>

          <div class="trust-i">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/>
              <path d="M4 8 6.5 3h11L20 8M9.5 12h5"/>
            </svg>
            <span>RECYCLABLE<br>PACKAGING</span>
          </div>

          <div class="trust-i">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/>
            </svg>
            <span>SAFE FOR<br>KIDS &amp; PETS</span>
          </div>

          <div class="trust-i">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="8.6"/>
              <path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/>
            </svg>
            <span>MADE IN<br>INDIA</span>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "BUNDLE CATEGORIES"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading Line 1",
      "default": "FIND THE RIGHT BUNDLE "
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Heading Line 2",
      "default": "FOR YOU"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Decorative Line",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show Trust Feature Bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Bundle Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "KITCHEN BUNDLE"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Category Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "text",
          "id": "icon_class",
          "label": "CSS Sprite Class (p-kitchen, p-toilet, p-laundry, p-tap)",
          "default": "p-kitchen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Target Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "KITCHEN BUNDLE",
            "subtitle": "Grease, dishes & more",
            "icon_class": "p-kitchen"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "BATHROOM BUNDLE",
            "subtitle": "Deep clean & disinfect",
            "icon_class": "p-toilet"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "LAUNDRY BUNDLE",
            "subtitle": "Softer, fresher wash",
            "icon_class": "p-laundry"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HARD WATER BUNDLE",
            "subtitle": "Melt away limescale",
            "icon_class": "p-tap"
          }
        }
      ]
    }
  ]
}
{% endschema %}
