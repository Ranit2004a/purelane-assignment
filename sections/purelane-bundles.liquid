{% comment %}
  Purelane Bundles Section
  Renders tier-based bundle builder cards with highlight badge & custom perks.
{% endcomment %}

<section class="sec purelane-body-root" id="bundles" data-scene="3">
  <div class="wrap purelane-wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      <h2 class="d2 purelane-d2">
        {{ section.settings.title_line1 | escape }}
        {%- if section.settings.title_line2 != blank -%}
          <span class="lime purelane-lime">{{ section.settings.title_line2 | escape }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.show_rule -%}
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
          </svg>
          <i></i>
        </div>
      {%- endif -%}
    </div>

    <div class="tiers">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="glass tier {% if block.settings.is_featured %}best{% endif %} rv" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <span class="tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}

            <div class="qty">
              {{ block.settings.quantity | escape }}
              <small>{{ block.settings.quantity_unit | escape }}</small>
            </div>

            <div class="price">
              {{ block.settings.price | escape }}
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price | escape }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.perks != blank -%}
              {%- assign perks_arr = block.settings.perks | newline_to_br | split: '<br />' -%}
              <ul>
                {%- for perk in perks_arr -%}
                  {%- assign clean_perk = perk | strip -%}
                  {%- if clean_perk != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      {{ clean_perk }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <a
              href="{{ block.settings.button_link | default: '#shop' }}"
              class="btn {% if block.settings.is_featured %}btn-primary purelane-btn-primary{% else %}btn-ghost purelane-btn-ghost{% endif %} btn-sm purelane-btn purelane-btn-sm"
            >
              {{ block.settings.button_text | escape }}
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback Tiers -->
        <div class="glass tier rv">
          <span class="tag">Starter Tier</span>
          <div class="qty">1 <small>Bottle</small></div>
          <div class="price">₹200 <s>₹299</s></div>
          <ul>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Choose any 1 product
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Standard shipping
            </li>
          </ul>
          <a href="#shop" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Select 1 Item</a>
        </div>

        <div class="glass tier best rv">
          <span class="tag">Popular Tier — 41% Off</span>
          <div class="qty">2 <small>Bottles</small></div>
          <div class="price">₹349 <s>₹598</s></div>
          <ul>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Mix & match any 2 items
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Free shipping India-wide
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Save ₹249 instantly
            </li>
          </ul>
          <a href="#shop" class="btn btn-primary btn-sm purelane-btn purelane-btn-primary purelane-btn-sm">Build 2 Pack</a>
        </div>

        <div class="glass tier rv">
          <span class="tag">Ultimate Tier — 44% Off</span>
          <div class="qty">3 <small>Bottles</small></div>
          <div class="price">₹499 <s>₹897</s></div>
          <ul>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Pick any 3 products
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Free express shipping
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Maximum savings (Save ₹398)
            </li>
          </ul>
          <a href="#shop" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Build 3 Pack</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "SAVINGS TIERS"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading Line 1",
      "default": "BUILD YOUR "
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Heading Line 2 (Highlighted)",
      "default": "BUNDLE."
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Decorative Rule",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier Block",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Highlight as Best/Popular Tier",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tier Badge Tag",
          "default": "Popular Tier — 41% Off"
        },
        {
          "type": "text",
          "id": "quantity",
          "label": "Quantity Number",
          "default": "2"
        },
        {
          "type": "text",
          "id": "quantity_unit",
          "label": "Unit Label",
          "default": "Bottles"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Tier Offer Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Tier Original Price",
          "default": "₹598"
        },
        {
          "type": "textarea",
          "id": "perks",
          "label": "Perks List (One per line)",
          "default": "Mix & match any 2 items\nFree shipping India-wide\nSave ₹249 instantly"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Build 2 Pack"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Target Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "is_featured": false,
            "tag": "Starter Tier",
            "quantity": "1",
            "quantity_unit": "Bottle",
            "price": "₹200",
            "compare_price": "₹299",
            "button_text": "Select 1 Item"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_featured": true,
            "tag": "Popular Tier — 41% Off",
            "quantity": "2",
            "quantity_unit": "Bottles",
            "price": "₹349",
            "compare_price": "₹598",
            "button_text": "Build 2 Pack"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_featured": false,
            "tag": "Ultimate Tier — 44% Off",
            "quantity": "3",
            "quantity_unit": "Bottles",
            "price": "₹499",
            "compare_price": "₹897",
            "button_text": "Build 3 Pack"
          }
        }
      ]
    }
  ]
}
{% endschema %}
