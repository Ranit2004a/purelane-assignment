          "default": "4.95"
        },
        {
          "type": "text",
          "id": "reviews_count",
          "label": "Reviews Count",
          "default": "512"
        },
        {
          "type": "text",
          "id": "icon_class",
          "label": "Fallback Icon Class",
          "default": "p-combo2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Kitchen + Bathroom Duo",
            "savings_tag": "SAVE ₹249",
            "price": "₹349",
            "compare_price": "₹598",
            "discount_tag": "41% OFF",
            "icon_class": "p-combo2"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Whole House Clean Trio",
            "savings_tag": "BEST VALUE",
            "price": "₹499",
            "compare_price": "₹897",
            "discount_tag": "44% OFF",
            "icon_class": "p-combo2"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Metal & Brass Spark Pack",
            "savings_tag": "SAVE ₹150",
            "price": "₹449",
            "compare_price": "₹599",
            "discount_tag": "25% OFF",
            "icon_class": "p-mbtl"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Laundry & Floor Care Pack",
            "savings_tag": "STARTER",
            "price": "₹599",
            "compare_price": "₹798",
            "discount_tag": "25% OFF",
            "icon_class": "p-kitchen"
          }
        }
      ]
    }
  ]
}
{% endschema %}
