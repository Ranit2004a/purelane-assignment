{% comment %}
  Purelane Best-Selling Combos Section
  Renders curated combo packs with savings pills, bottle stacks, and hover animations matching reference design.
{% endcomment %}

<section class="sec purelane-body-root purelane-combos-section" id="combos" data-scene="3">
  <div class="wrap purelane-wrap">
    
    <!-- Section Header -->
    <div class="panel-head rv" style="margin-bottom: 32px;">
      <span class="kicker purelane-kicker">{{ section.settings.kicker | default: 'PRE-BUILT TO SAVE YOU MONEY' }}</span>
      <h2 class="d2 purelane-d2" style="margin-top: 10px;">
        {{ section.settings.title | default: 'BEST SELLING COMBOS' }}
      </h2>
      <div class="rule" style="margin: 12px auto 16px;">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      <p class="lede purelane-lede" style="margin: 0 auto; text-align: center;">
        {{ section.settings.description | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' }}
      </p>
    </div>

    <!-- Combos Grid -->
    <div class="combos-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign combo_product = block.settings.product -%}
          <div class="glass combo-card rv {% if block.settings.is_featured %}featured-combo{% endif %}" {{ block.shopify_attributes }}>
            
            <!-- Top Tray with Product Visuals -->
            <div class="combo-tray">
              {%- if block.settings.savings_pill != blank -%}
                <span class="combo-save-pill">{{ block.settings.savings_pill | escape }}</span>
              {%- endif -%}
              {%- if block.settings.badge_tag != blank -%}
                <span class="combo-badge-tag">{{ block.settings.badge_tag | escape }}</span>
              {%- endif -%}

              <!-- Bottle Stack -->
              <div class="combo-stack">
                <div class="stack-item">
                  <span class="pimg {{ block.settings.p1_icon | default: 'p-kitchen' }}"></span>
                  <span class="stack-cap">{{ block.settings.p1_cap | default: 'Cuts grease instantly' }}</span>
                </div>
                <span class="stack-plus">+</span>
                
                <div class="stack-item">
                  {%- if block.settings.p2_is_tile -%}
                    <div class="stack-tile">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                        <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                      </svg>
                    </div>
                  {%- else -%}
                    <span class="pimg {{ block.settings.p2_icon | default: 'p-dish' }}"></span>
                  {%- endif -%}
                  <span class="stack-cap">{{ block.settings.p2_cap | default: 'Squeaky clean dishes' }}</span>
                </div>
                <span class="stack-plus">+</span>

                <div class="stack-item">
                  <span class="pimg {{ block.settings.p3_icon | default: 'p-tap' }}"></span>
                  <span class="stack-cap">{{ block.settings.p3_cap | default: 'Melts hard water stains' }}</span>
                </div>
              </div>
            </div>

            <!-- Bottom Details Body -->
            <div class="combo-body">
              <h3 class="combo-title">{{ block.settings.title | escape }}</h3>
              <span class="combo-count">{{ block.settings.product_count | default: '3 PRODUCTS' }}</span>
              <p class="combo-desc">{{ block.settings.description | escape }}</p>

              <div class="combo-price-row">
                <strong class="combo-price">{{ block.settings.price | escape }}</strong>
                {%- if block.settings.compare_price != blank -%}
                  <s class="combo-compare-price">{{ block.settings.compare_price | escape }}</s>
                {%- endif -%}
                {%- if block.settings.discount_pill != blank -%}
                  <span class="combo-discount-tag">{{ block.settings.discount_pill | escape }}</span>
                {%- endif -%}
              </div>
              <span class="combo-subtext">Inclusive of all taxes · COD available</span>

              {%- if combo_product != blank and combo_product.available -%}
                {%- form 'product', combo_product, class: 'combo-card-form' -%}
                  <input type="hidden" name="id" value="{{ combo_product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="btn purelane-btn purelane-btn-ghost combo-btn">
                    SHOP BUNDLE &rarr;
                  </button>
                {%- endform -%}
              {%- else -%}
                <button type="button" class="btn purelane-btn purelane-btn-ghost combo-btn">
                  SHOP BUNDLE &rarr;
                </button>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      {%- else -%}
