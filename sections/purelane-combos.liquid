{% comment %}
  Purelane Best-Selling Combos Section
  Renders curated combo packs with savings pills and one-click add to cart.
{% endcomment %}

<section class="sec purelane-body-root" id="combos" data-scene="3">
  <div class="wrap purelane-wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      <h2 class="d2 purelane-d2">
        {{ section.settings.title_line1 | escape }}
        {%- if section.settings.title_line2 != blank -%}
          <span class="lime purelane-lime">{{ section.settings.title_line2 | escape }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.show_rule -%}
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
          </svg>
          <i></i>
        </div>
      {%- endif -%}
    </div>

    <div class="shelf">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign combo_product = block.settings.product -%}
          <div class="glass card rv" {{ block.shopify_attributes }}>
            <div class="shot">
              {%- if block.settings.savings_tag != blank -%}
                <span class="pill">{{ block.settings.savings_tag | escape }}</span>
              {%- endif -%}
              {%- if combo_product != blank and combo_product.featured_media != blank -%}
                <img
                  src="{{ combo_product.featured_media | image_url: width: 300 }}"
                  alt="{{ combo_product.title | escape }}"
                  loading="lazy"
                  width="150"
                  height="150"
                  style="object-fit: contain; max-height: 122px;"
                >
              {%- else -%}
                <span class="pimg {{ block.settings.icon_class | default: 'p-combo2' }}" role="img" aria-label="{{ block.settings.title }}"></span>
              {%- endif -%}
            </div>

            <h4 class="product-card-title">
              {%- if combo_product != blank -%}
                {{ combo_product.title | escape }}
              {%- else -%}
                {{ block.settings.title | escape }}
              {%- endif -%}
            </h4>

            <div class="rate">
              <b>★ {{ block.settings.rating | default: '4.95' }}</b> ({{ block.settings.reviews_count | default: '480' }} reviews)
            </div>

            <div class="pr">
              {%- if combo_product != blank -%}
                <strong>{{ combo_product.price | money }}</strong>
                {%- if combo_product.compare_at_price > combo_product.price -%}
                  <s>{{ combo_product.compare_at_price | money }}</s>
                  {%- assign sav_pct = combo_product.compare_at_price | minus: combo_product.price | times: 100 | divided_by: combo_product.compare_at_price -%}
                  <em>{{ sav_pct }}% OFF</em>
                {%- endif -%}
              {%- else -%}
                <strong>{{ block.settings.price | escape }}</strong>
                {%- if block.settings.compare_price != blank -%}
                  <s>{{ block.settings.compare_price | escape }}</s>
                {%- endif -%}
                {%- if block.settings.discount_tag != blank -%}
                  <em>{{ block.settings.discount_tag | escape }}</em>
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if combo_product != blank and combo_product.available -%}
              {%- form 'product', combo_product, class: 'product-card-form' -%}
                <input type="hidden" name="id" value="{{ combo_product.selected_or_first_available_variant.id }}">
                <button type="submit" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm" style="width:100%;">
                  Add Combo
                </button>
              {%- endform -%}
            {%- else -%}
              <button type="button" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Add Combo</button>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Mock Fallback Best-selling Combos -->
        <div class="glass card rv">
          <div class="shot">
            <span class="pill">SAVE ₹249</span>
            <span class="pimg p-combo2" role="img" aria-label="Kitchen & Tap cleaner combo"></span>
          </div>
          <h4 class="product-card-title">Kitchen + Bathroom Duo</h4>
          <div class="rate"><b>★ 4.95</b> (512 reviews)</div>
          <div class="pr">
            <strong>₹349</strong><s>₹598</s><em>41% OFF</em>
          </div>
          <button type="button" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Add Combo</button>
        </div>

        <div class="glass card rv">
          <div class="shot">
            <span class="pill">BEST VALUE</span>
            <span class="pimg p-combo2" role="img" aria-label="Whole house clean trio"></span>
          </div>
          <h4 class="product-card-title">Whole House Clean Trio</h4>
          <div class="rate"><b>★ 4.98</b> (780 reviews)</div>
          <div class="pr">
            <strong>₹499</strong><s>₹897</s><em>44% OFF</em>
          </div>
          <button type="button" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Add Combo</button>
        </div>

        <div class="glass card rv">
          <div class="shot">
            <span class="pill">SAVE ₹150</span>
            <span class="pimg p-mbtl" role="img" aria-label="Metal & Copper spark duo"></span>
          </div>
          <h4 class="product-card-title">Metal & Brass Spark Pack</h4>
          <div class="rate"><b>★ 4.91</b> (240 reviews)</div>
          <div class="pr">
            <strong>₹449</strong><s>₹599</s><em>25% OFF</em>
          </div>
          <button type="button" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Add Combo</button>
        </div>

        <div class="glass card rv">
          <div class="shot">
            <span class="pill">STARTER</span>
            <span class="pimg p-kitchen" role="img" aria-label="Laundry & Floor essentials"></span>
          </div>
          <h4 class="product-card-title">Laundry & Floor Care Pack</h4>
          <div class="rate"><b>★ 4.88</b> (310 reviews)</div>
          <div class="pr">
            <strong>₹599</strong><s>₹798</s><em>25% OFF</em>
          </div>
          <button type="button" class="btn btn-ghost btn-sm purelane-btn purelane-btn-ghost purelane-btn-sm">Add Combo</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "MOST POPULAR"
    },
    {
      "type": "text",
      "id": "title_line1",
