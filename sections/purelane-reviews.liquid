{% comment %}
  Purelane Reviews Rail Section
  Renders verified customer reviews with star ratings, quotes, and reviewer details.
{% endcomment %}

<section class="sec revband purelane-body-root" id="reviews" data-scene="1">
  <div class="wrap purelane-wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      <h2 class="d2 purelane-d2">
        {{ section.settings.title_line1 | escape }}
        {%- if section.settings.title_line2 != blank -%}
          <span class="lime purelane-lime">{{ section.settings.title_line2 | escape }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.show_rule -%}
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/>
          </svg>
          <i></i>
        </div>
      {%- endif -%}
    </div>

    <div class="reviews-marquee-wrapper">
      <div class="reviews-marquee-track">
        <div class="reviews-marquee-group">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="glass voice rv" {{ block.shopify_attributes }}>
                <div class="st">{{ block.settings.stars | escape }}</div>
                <h4>{{ block.settings.heading | escape }}</h4>
                <p>{{ block.settings.quote | escape }}</p>
                <cite>&mdash; {{ block.settings.author | escape }}</cite>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Default Fallback Reviews -->
            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Grease melted in 10 seconds"</h4>
              <p>I was skeptical about a plant-based cleaner on Indian chimney grease, but this foam literally dissolved months of oil buildup without any harsh chemical fumes.</p>
              <cite>&mdash; Ananya S., Mumbai</cite>
            </div>

            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Tap looks brand new"</h4>
              <p>Hard water stains on bathroom brass fittings had been bothering me for years. One spray of the tap cleaner and wiped with cloth &mdash; spotless shine!</p>
              <cite>&mdash; Rahul M., Bengaluru</cite>
            </div>

            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Safe around my pets"</h4>
              <p>Switched all floor cleaners to Purelane Neem floor cleaner. Smells incredibly fresh and natural, and I don't have to worry about my dog licking the floor.</p>
              <cite>&mdash; Priyanka K., Delhi</cite>
            </div>

            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Worth every rupee"</h4>
              <p>The 3-bottle bundle is fantastic value. Delivery was super fast, packaging eco-friendly, and the products actually work better than big brand chemicals.</p>
              <cite>&mdash; Vikram R., Pune</cite>
            </div>
          {%- endif -%}
        </div>

        <!-- Duplicated Group for Infinite Seamless Right-to-Left Loop -->
        <div class="reviews-marquee-group" aria-hidden="true">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="glass voice rv">
                <div class="st">{{ block.settings.stars | escape }}</div>
                <h4>{{ block.settings.heading | escape }}</h4>
                <p>{{ block.settings.quote | escape }}</p>
                <cite>&mdash; {{ block.settings.author | escape }}</cite>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Default Fallback Reviews -->
            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Grease melted in 10 seconds"</h4>
              <p>I was skeptical about a plant-based cleaner on Indian chimney grease, but this foam literally dissolved months of oil buildup without any harsh chemical fumes.</p>
              <cite>&mdash; Ananya S., Mumbai</cite>
            </div>

            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Tap looks brand new"</h4>
              <p>Hard water stains on bathroom brass fittings had been bothering me for years. One spray of the tap cleaner and wiped with cloth &mdash; spotless shine!</p>
              <cite>&mdash; Rahul M., Bengaluru</cite>
            </div>

            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Safe around my pets"</h4>
              <p>Switched all floor cleaners to Purelane Neem floor cleaner. Smells incredibly fresh and natural, and I don't have to worry about my dog licking the floor.</p>
              <cite>&mdash; Priyanka K., Delhi</cite>
            </div>

            <div class="glass voice rv">
              <div class="st">★★★★★</div>
              <h4>"Worth every rupee"</h4>
              <p>The 3-bottle bundle is fantastic value. Delivery was super fast, packaging eco-friendly, and the products actually work better than big brand chemicals.</p>
              <cite>&mdash; Vikram R., Pune</cite>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "VERIFIED REVIEWS"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading Line 1",
      "default": "WHAT PEOPLE "
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Heading Line 2 (Highlighted)",
      "default": "SAY."
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Decorative Rule",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Star Rating Display",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Review Headline Quote",
          "default": "\"Grease melted in 10 seconds\""
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Full Review Text",
          "default": "I was skeptical about a plant-based cleaner on Indian chimney grease, but this foam literally dissolved months of oil buildup without any harsh chemical fumes."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author & Location",
          "default": "Ananya S., Mumbai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
