{% comment %}
  Purelane Shop / Product Grid Section
  Renders responsive 4-column grid of products matching reference design.
{% endcomment %}

<section class="sec purelane-body-root" id="shop" data-scene="3">
  <div class="wrap purelane-wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      <h2 class="d2 purelane-d2" style="margin-top:12px;">
        {{ section.settings.title_line1 | escape }}
        {%- if section.settings.title_line2 != blank -%}
          <span class="lime purelane-lime">{{ section.settings.title_line2 | escape }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.show_rule -%}
        <div class="rule" style="margin:14px auto 0;">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>
      {%- endif -%}
    </div>

    <div class="shelf">
      {%- if section.settings.product_list != blank -%}
        {%- for prod in section.settings.product_list -%}
          {% render 'purelane-product-card', product: prod %}
        {%- endfor -%}
      {%- elsif section.settings.collection != blank -%}
        {%- for prod in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'purelane-product-card', product: prod %}
        {%- endfor -%}
      {%- else -%}
        <!-- Mock Fallback Product Grid (8 Products matching screenshot) -->
        {% render 'purelane-product-card', title: 'Tap cleaner & limescale remover', price: '₹200', compare_price: '₹299', badge: 'BEST SELLER', icon_class: 'p-tap', rating: '4.8', reviews_count: '237', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Kitchen cleaner, foaming', price: '₹200', compare_price: '₹299', badge: 'BEST SELLER', icon_class: 'p-kitchen', rating: '4.8', reviews_count: '254', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Copper, bronze & brass cleaner', price: '₹200', compare_price: '₹299', badge: 'TOP RATED', icon_class: 'p-metal', rating: '4.8', reviews_count: '231', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Washing machine cleaner & descaler', price: '₹200', compare_price: '₹299', badge: 'NEW', icon_class: 'p-wm', rating: '4.8', reviews_count: '183', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Tap cleaner & limescale remover', price: '₹200', compare_price: '₹299', badge: 'BEST SELLER', icon_class: 'p-tap', rating: '4.8', reviews_count: '237', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Kitchen cleaner, foaming', price: '₹200', compare_price: '₹299', badge: 'BEST SELLER', icon_class: 'p-kitchen', rating: '4.8', reviews_count: '254', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Copper, bronze & brass cleaner', price: '₹200', compare_price: '₹299', badge: 'TOP RATED', icon_class: 'p-metal', rating: '4.8', reviews_count: '231', discount_tag: '33% off' %}
        {% render 'purelane-product-card', title: 'Washing machine cleaner & descaler', price: '₹200', compare_price: '₹299', badge: 'NEW', icon_class: 'p-wm', rating: '4.8', reviews_count: '183', discount_tag: '33% off' %}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    function initShopCards() {
      var shopCards = document.querySelectorAll('#shop .card');
      shopCards.forEach(function(card) {
        card.addEventListener('click', function(e) {
          if (e.target.tagName === 'BUTTON' || e.target.closest('button') || e.target.tagName === 'A') return;
          shopCards.forEach(function(c) { c.classList.remove('active'); });
          this.classList.add('active');
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShopCards);
    } else {
      initShopCards();
    }
  })();
</script>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "BESTSELLERS"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading Line 1",
      "default": "LOVED BY 30,000 HOMES"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Heading Line 2 (Highlighted)",
      "default": "BESTSELLERS"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show Decorative Rule",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select Products directly"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
