{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    <li>
      <a id="HeaderMenu-hero" href="{{ routes.root_url }}#top" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>Hero</span>
      </a>
    </li>
    <li>
      <a id="HeaderMenu-shop" href="{{ routes.root_url }}#shop" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>Shop</span>
      </a>
    </li>
    <li>
      <a id="HeaderMenu-combos" href="{{ routes.root_url }}#combos" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>Combos</span>
      </a>
    </li>
    <li>
      <a id="HeaderMenu-bundles" href="{{ routes.root_url }}#bundles" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>Bundles</span>
      </a>
    </li>
    <li>
      <a id="HeaderMenu-reviews" href="{{ routes.root_url }}#reviews" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>Reviews</span>
      </a>
    </li>
    {%- for link in section.settings.menu.links -%}
      {%- assign link_title_dn = link.title | downcase -%}
      {%- unless link_title_dn == 'home' or link_title_dn == 'catalog' -%}
        <li>
          <a id="HeaderMenu-{{ link.handle }}" href="{{ link.url }}" class="header__menu-item list-menu__item link link--text focus-inset">
            <span>{{ link.title | escape }}</span>
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</nav>
